      "serverReadyAction": {
        "pattern": "Local:\\s+(http://(?:127\\.0\\.0\\.1|localhost):5173/)",
        "uriFormat": "%s",
        "action": "debugWithEdge"
      }
    },
    {
      "name": "Quote Repository: Open Browser Only",
      "type": "node-terminal",
